# Postgres connection string. Local: `docker compose up -d` and use the value
# below. Production: the Neon connection string (set by the Vercel integration).
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Public URL of the site, used for metadata, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vercel Blob token. When set, media uploads go to Blob instead of ./media.
# Required in production; leave empty locally.
BLOB_READ_WRITE_TOKEN=
# Optional, dev only: comma-separated hosts allowed to load dev scripts,
# e.g. your LAN IP when opening the site from another device.
DEV_ALLOWED_ORIGINS=
